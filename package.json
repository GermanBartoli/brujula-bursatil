{
  "name": "brujula-bursatil",
  "version": "0.5.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && vite build --config vite.worker.config.ts",
    "preview": "wrangler pages dev dist --port 8787",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
